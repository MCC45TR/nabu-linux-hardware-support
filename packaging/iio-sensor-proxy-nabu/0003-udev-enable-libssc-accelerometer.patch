From: SENEMOS Project <senemos@localhost>
Subject: [PATCH] udev: expose the libssc accelerometer on FastRPC DSPs

The SSC accelerometer backend is built, but FastRPC devices were tagged only
for light and compass sensors.  Add ssc-accel so SensorProxy advertises the
accelerometer used by KWin automatic rotation.
---
 data/80-iio-sensor-proxy.rules | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/data/80-iio-sensor-proxy.rules b/data/80-iio-sensor-proxy.rules
index 59e056d..9245181 100644
--- a/data/80-iio-sensor-proxy.rules
+++ b/data/80-iio-sensor-proxy.rules
@@ -22,7 +22,7 @@ SUBSYSTEM=="input", ENV{ID_INPUT_ACCELEROMETER}=="1", ENV{IIO_SENSOR_PROXY_TYPE}
 # Some devices expose the sensors via a separate SDSP while others re-use ADSP.
 # These DSPs expose itself as /dev/fastrpc-* in the misc subsystem.
-SUBSYSTEM=="misc", KERNEL=="fastrpc-adsp*", ENV{IIO_SENSOR_PROXY_TYPE}+="ssc-light ssc-compass"
-SUBSYSTEM=="misc", KERNEL=="fastrpc-sdsp*", ENV{IIO_SENSOR_PROXY_TYPE}+="ssc-light ssc-compass"
+SUBSYSTEM=="misc", KERNEL=="fastrpc-adsp*", ENV{IIO_SENSOR_PROXY_TYPE}+="ssc-accel ssc-light ssc-compass"
+SUBSYSTEM=="misc", KERNEL=="fastrpc-sdsp*", ENV{IIO_SENSOR_PROXY_TYPE}+="ssc-accel ssc-light ssc-compass"
 
 ENV{IIO_SENSOR_PROXY_TYPE}=="", GOTO="iio_sensor_proxy_end"
 
-- 
2.50.1
