#!/usr/bin/bash
# Keep the graphical session behind a bounded SSC readiness check. If the
# first iio-sensor-proxy enumeration raced SLPI publication, restart the daemon
# once and retry. Failure remains non-fatal so an unavailable sensor DSP never
# prevents the user from reaching the desktop and rolling the package back.

set -u

busctl_bin=${NABU_SENSOR_GATE_BUSCTL:-/usr/bin/busctl}
systemctl_bin=${NABU_SENSOR_GATE_SYSTEMCTL:-/usr/bin/systemctl}
sleep_bin=${NABU_SENSOR_GATE_SLEEP:-/usr/bin/sleep}
initial_attempts=${NABU_SENSOR_GATE_INITIAL_ATTEMPTS:-20}
recovery_attempts=${NABU_SENSOR_GATE_RECOVERY_ATTEMPTS:-40}
interval=${NABU_SENSOR_GATE_INTERVAL:-0.25}

sensor_ready() {
	[[ $("${busctl_bin}" get-property net.hadess.SensorProxy \
		/net/hadess/SensorProxy net.hadess.SensorProxy \
		HasAccelerometer 2>/dev/null || :) == 'b true' ]]
}

wait_for_sensor() {
	local attempts=$1
	local attempt

	for ((attempt = 0; attempt < attempts; attempt++)); do
		if sensor_ready; then
			return 0
		fi
		"${sleep_bin}" "${interval}"
	done
	return 1
}

if wait_for_sensor "${initial_attempts}"; then
	echo 'Nabu sensor gate: accelerometer was ready before the graphical session.'
	exit 0
fi

echo 'Nabu sensor gate: restarting iio-sensor-proxy after a late SLPI enumeration.' >&2
if ! "${systemctl_bin}" restart iio-sensor-proxy.service; then
	echo 'Nabu sensor gate: restart failed; continuing without blocking the desktop.' >&2
	exit 0
fi

if wait_for_sensor "${recovery_attempts}"; then
	echo 'Nabu sensor gate: accelerometer became ready after one bounded restart.'
	exit 0
fi

echo 'Nabu sensor gate: accelerometer is still unavailable; continuing with the current desktop behavior.' >&2
exit 0
