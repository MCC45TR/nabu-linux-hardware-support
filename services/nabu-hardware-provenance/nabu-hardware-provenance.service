[Unit]
Description=Read-only Xiaomi Nabu hardware provenance inventory
Documentation=file:///usr/share/doc/nabu-hardware-provenance/README.md
ConditionPathExists=/sys/firmware/devicetree/base/compatible
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/senemos-nabu/nabu-hardware-provenance
RemainAfterExit=yes
User=nabu-provenance
Group=nabu-provenance
RuntimeDirectory=nabu-hardware
RuntimeDirectoryMode=0755
UMask=0022

# The udev rule gives this dedicated user read access only to dtbo_a/dtbo_b.
# At the device-cgroup layer, every SCSI/UFS block major named "sd" is
# independently restricted to reads, covering Nabu's sda-sdf LUN layout
# without embedding unstable device paths or numeric major/minor assignments.
DevicePolicy=closed
DeviceAllow=block-sd r
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
IPAddressDeny=any
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
