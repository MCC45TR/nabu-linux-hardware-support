[Unit]
Description=Read-only Xiaomi Nabu hardware provenance inventory
Documentation=file:///usr/share/doc/nabu-hardware-provenance/README.md
ConditionPathExists=/sys/firmware/devicetree/base/compatible
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/senemos-nabu/nabu-hardware-provenance
RemainAfterExit=yes
User=nabu-provenance
Group=nabu-provenance
RuntimeDirectory=nabu-hardware
RuntimeDirectoryMode=0755
UMask=0022

# The udev rule gives this dedicated user read access only to dtbo_a/dtbo_b.
# At the device-cgroup layer, both whole SCSI/UFS LUNs (sd) and dynamically
# allocated partitions (blkext) are restricted to reads.  DAC below this layer
# still grants the service account access only to dtbo_a and dtbo_b.
DevicePolicy=closed
DeviceAllow=block-sd r
DeviceAllow=block-blkext r
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
IPAddressDeny=any
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
