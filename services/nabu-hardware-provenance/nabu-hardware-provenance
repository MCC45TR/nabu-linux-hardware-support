"""Build a privacy-preserving, read-only Nabu hardware provenance report.

The program intentionally never mounts Android partitions, parses modem NV,
exports radio addresses, reads camera EEPROM payloads, or applies a DTBO.  Its
only raw block-device reads are bounded O_RDONLY reads of the two allow-listed
DTBO partitions.
"""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import re
import stat
import struct
import subprocess
import sys
import tempfile
from typing import Any


DT_TABLE_MAGIC = 0xD7B7AB1E
FDT_MAGIC = 0xD00DFEED
FDT_BEGIN_NODE = 1
FDT_END_NODE = 2
FDT_PROP = 3
FDT_NOP = 4
FDT_END = 9
MAX_DTBO_SIZE = 64 * 1024 * 1024
MAX_DTBO_ENTRIES = 64

KNOWN_PANEL_REVISIONS = ("36-02-0b", "42-02-0a")
FEATURE_MARKERS: tuple[tuple[str, tuple[bytes, ...]], ...] = (
    ("xiaomi-nabu", (b"xiaomi,nabu", b"xiaomi nabu")),
    ("panel-36-02-0b", (b"36_02_0b", b"36-02-0b")),
    ("panel-42-02-0a", (b"42_02_0a", b"42-02-0a")),
