    ("xiaomi-keyboard", (b"xiaomi-keyboard", b"xiaomi_keyboard")),
    ("ov13b10-rear-camera", (b"ov13b10",)),
    ("ov8856-front-camera", (b"ov8856",)),
    ("nt36523-touch-display", (b"nt36523",)),
    ("usb-power-delivery", (b"usbpd", b"usb-pd", b"typec")),
)

FIRMWARE_FILES: tuple[tuple[str, str], ...] = (
    ("adsp", "qcom/sm8150/xiaomi/nabu/adsp.mbn"),
    ("cdsp", "qcom/sm8150/xiaomi/nabu/cdsp.mbn"),
